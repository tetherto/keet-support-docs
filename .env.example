# Copy to `.env` and set your GitHub PAT (classic token with `read:packages`).
# Export GITHUB_TOKEN in your shell before `npm install`, or use direnv / dotenv-cli.
#
# https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional — production canonical URLs (defaults to https://support.keet.io locally)
# NEXT_PUBLIC_DOCS_ORIGIN=https://support.keet.io
